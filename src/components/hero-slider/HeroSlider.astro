---
import "./hero-slider.css";
import type { HeroSlideItem, HeroSliderProps, SlideLayout } from "./hero-slider.types";

const {
  items = [],
  ariaLabel = "Promociones destacadas",
  class: className = "",
} = Astro.props as HeroSliderProps;

function getLayout(item: HeroSlideItem, index: number): SlideLayout {
  if (item.layout) return item.layout;
  return index % 2 === 0 ? "right" : "left";
}

const safeItems = Array.isArray(items)
  ? items.filter((item): item is HeroSlideItem =>
      Boolean(
        item && item.active !== false && item.title && item.image && item.link,
      ),
    )
  : [];
const hasControls = safeItems.length > 1;
---

{
  safeItems.length > 0 && (
    <section
      class={`hero-slider ${className}`}
      aria-label={ariaLabel}
      aria-roledescription="carrusel"
      data-hero-slider
      tabindex="0"
    >
      <div class="hero-slider__track">
        {safeItems.map((item, index) => {
          const layout = getLayout(item, index);
          const isReverse = layout === "left";
          const isActive = index === 0;

          return (
            <article
              class={`hero-slide ${isReverse ? "hero-slide--reverse" : ""} ${isActive ? "is-active" : ""}`}
              data-slide
              aria-hidden={!isActive}
              inert={!isActive}
            >
              <div class="hero-slide__shape" aria-hidden="true" />
              <div class="hero-slide__container">
                <div class="hero-slide__content">
                  <div class="hero-slide__content-inner">
                    {item.eyebrow && (
                      <p class="hero-slide__eyebrow">{item.eyebrow}</p>
                    )}
                    <h2 class="hero-slide__title">{item.title}</h2>
                    {item.description && (
                      <p class="hero-slide__desc">{item.description}</p>
                    )}

                    <div class="hero-slide__actions">
                      <a class="hero-slide__button" href={item.link}>
                        {item.buttonText ?? "Ver más"}
                      </a>
                    </div>
                  </div>
                </div>

                <div class="hero-slide__media">
                  <div class="hero-slide__media-inner">
                    <img
                      class="hero-slide__image"
                      src={item.image}
                      alt={item.title}
                      loading={isActive ? "eager" : "lazy"}
                      draggable="false"
                    />
                  </div>
                </div>
              </div>
            </article>
          );
        })}

        {hasControls && (
          <div
            class="hero-slider__controls"
            data-controls
            role="group"
            aria-label="Controles del slider"
          >
            <button
              class="hero-slider__nav hero-slider__nav--prev"
              data-prev
              aria-label="Anterior"
              type="button"
            >
              <span aria-hidden="true">‹</span>
            </button>

            <div class="hero-slider__dots" role="group" aria-label="Indicadores">
              {safeItems.map((item, index) => (
                <button
                  class={`hero-slider__dot ${index === 0 ? "is-active" : ""}`}
                  data-dot={index}
                  aria-label={`Ir al slide ${index + 1}: ${item.title}`}
                  aria-pressed={index === 0 ? "true" : "false"}
                  type="button"
                />
              ))}
            </div>

            <button
              class="hero-slider__nav hero-slider__nav--next"
              data-next
              aria-label="Siguiente"
              type="button"
            >
              <span aria-hidden="true">›</span>
            </button>
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  import { initAllHeroSliders } from "./hero-slider";

  const init = () => initAllHeroSliders();

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }

  document.addEventListener("astro:page-load", init);
</script>
