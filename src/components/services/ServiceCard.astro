---
import type { PrintingService } from "@/data/services.data";

const { service } = Astro.props as { service: PrintingService };
const primaryImage = service.images[0];
---

<a class="service-card" href={`/servicios/${service.slug}`} aria-label={`Ver detalle de ${service.title}`}>
  <img
    src={primaryImage.src}
    width="300"
    height="225"
    alt={primaryImage.alt}
    loading="lazy"
  />
  <h2>{service.title}</h2>
</a>

<style>
  .service-card {
    color: inherit;
    background: var(--white);
    border: 1px solid #d9e2ec;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
    padding: 12px;
    text-decoration: none;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .service-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    border-radius: 8px;
  }

  .service-card h2 {
    color: #102a43;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .service-card:hover,
  .service-card:focus-visible {
    box-shadow: 0 6px 16px rgba(16, 42, 67, 0.12);
    transform: translateY(-1px);
  }

  .service-card:focus-visible {
    outline: 2px solid #0ea5e9;
    outline-offset: 2px;
  }
</style>
